// ToClientModel converts one block to the client type the request carries.
func (m *{{nestedModel}}) ToClientModel() (*client.{{nestedClientType}}, error) {
	out := &client.{{nestedClientType}}{}
{{#nested}}
{{#isString}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = m.{{goName}}.ValueString()
	}
{{/isString}}
{{#isRtid}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = client.RTID(m.{{goName}}.ValueString())
	}
{{/isRtid}}
{{#isInt64}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = {{goType}}(m.{{goName}}.ValueInt64())
	}
{{/isInt64}}
{{#isFloat64}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = {{goType}}(m.{{goName}}.ValueFloat64())
	}
{{/isFloat64}}
{{#isBool}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		{{goName}} := m.{{goName}}.ValueBool()
		out.{{goName}} = &{{goName}}
	}
{{/isBool}}
{{#isJson}}
	// Deeper than nestedMaxDepth, so this child is JSON inside a typed block.
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		if err := json.Unmarshal([]byte(m.{{goName}}.ValueString()), &out.{{goName}}); err != nil {
			return out, fmt.Errorf("{{terraformName}}: %w", err)
		}
	}
{{/isJson}}
{{/nested}}
	return out, nil
}

// FromClientModel fills one block from what the server answered.
//
// EVERY CHILD IS WRITTEN, not only the ones the configuration set, because they
// are Optional AND Computed: Polar fills in a price's currency and tax
// behaviour, and a Computed attribute left unknown after an apply is "provider
// returned invalid result object after apply".
func (m *{{nestedModel}}) FromClientModel(c *client.{{nestedClientType}}) {
{{#nested}}
{{#isString}}
	m.{{goName}} = types.StringValue(c.{{goName}})
{{/isString}}
{{#isRtid}}
	m.{{goName}} = types.StringValue(string(c.{{goName}}))
{{/isRtid}}
{{#isInt64}}
	m.{{goName}} = types.Int64Value(int64(c.{{goName}}))
{{/isInt64}}
{{#isFloat64}}
	m.{{goName}} = types.Float64Value(float64(c.{{goName}}))
{{/isFloat64}}
{{#isBool}}
	if c.{{goName}} != nil {
		m.{{goName}} = types.BoolValue(*c.{{goName}})
	} else {
		m.{{goName}} = types.BoolNull()
	}
{{/isBool}}
{{#isJson}}
	if encoded, err := json.Marshal(c.{{goName}}); err == nil {
		if m.{{goName}}.IsNull() || m.{{goName}}.IsUnknown() ||
			!jsonSupersetOf(string(encoded), m.{{goName}}.ValueString()) {
			m.{{goName}} = jsontypes.NewNormalizedValue(string(encoded))
		}
	}
{{/isJson}}
{{/nested}}
}
