	}
{{/isBool}}
{{#isJson}}
	// A silently dropped field is worse than a loud one: bad JSON here means
	// the configuration said something this resource cannot send, and the
	// request would otherwise go out quietly missing it.
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		if err := json.Unmarshal([]byte(m.{{goName}}.ValueString()), &out.{{goName}}); err != nil {
			return out, fmt.Errorf("{{terraformName}}: %w", err)
		}
	}
{{/isJson}}
{{#isNested}}
{{#isNestedList}}
	if len(m.{{goName}}) > 0 {
		out.{{goName}} = make([]client.{{nestedClientType}}, 0, len(m.{{goName}}))
		for index := range m.{{goName}} {
			converted, err := m.{{goName}}[index].ToClientModel()
			if err != nil {
				return out, fmt.Errorf("{{terraformName}}[%d]: %w", index, err)
			}
			out.{{goName}} = append(out.{{goName}}, *converted)
		}
	}
{{/isNestedList}}
{{#isNestedObject}}
	if m.{{goName}} != nil {
		converted, err := m.{{goName}}.ToClientModel()
		if err != nil {
			return out, fmt.Errorf("{{terraformName}}: %w", err)
		}
		out.{{goName}} = {{^nestedPointer}}*{{/nestedPointer}}converted
	}
{{/isNestedObject}}
{{/isNested}}
{{/inRequest}}
{{/tfAttributes}}
	return out, nil
}
