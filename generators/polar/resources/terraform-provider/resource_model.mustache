// ToClientModel converts a Terraform model to a client model.
func (m *{{resourceClassName}}Model) ToClientModel() (*client.{{requestModel}}, error) {
	out := &client.{{requestModel}}{}
{{#tfAttributes}}
{{#inRequest}}
{{#isString}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = m.{{goName}}.ValueString()
	}
{{/isString}}
{{#isRtid}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = client.RTID(m.{{goName}}.ValueString())
	}
{{/isRtid}}
{{#isInt64}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = {{goType}}(m.{{goName}}.ValueInt64())
	}
{{/isInt64}}
{{#isFloat64}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		out.{{goName}} = {{goType}}(m.{{goName}}.ValueFloat64())
	}
{{/isFloat64}}
{{#isBool}}
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		// Addressed, not assigned: the client field is a *bool so that an
		// explicit false is sent rather than dropped by `omitempty`.
		{{goName}} := m.{{goName}}.ValueBool()
		out.{{goName}} = &{{goName}}
	}
{{/isBool}}
{{#isJson}}
	// A silently dropped field is worse than a loud one: bad JSON here means
	// the configuration said something this resource cannot send, and the
	// request would otherwise go out quietly missing it.
	if !m.{{goName}}.IsNull() && !m.{{goName}}.IsUnknown() {
		if err := json.Unmarshal([]byte(m.{{goName}}.ValueString()), &out.{{goName}}); err != nil {
			return out, fmt.Errorf("{{terraformName}}: %w", err)
		}
	}
{{/isJson}}
{{/inRequest}}
{{/tfAttributes}}
	return out, nil
}
{{/requestModel}}

