func (r *{{resourceClassName}}Resource) Create(ctx context.Context, req resource.CreateRequest, resp *resource.CreateResponse) {
	var plan {{resourceClassName}}Model

	resp.Diagnostics.Append(req.Plan.Get(ctx, &plan)...)
	if resp.Diagnostics.HasError() {
		return
	}

{{#requestModel}}
	reqBody, err := plan.ToClientModel()
	if err != nil {
		resp.Diagnostics.AddError("Invalid {{resourceName}} configuration", err.Error())
		return
	}
{{/requestModel}}
{{^requestModel}}
	// This operation takes no request body.
	var reqBody interface{}
{{/requestModel}}

	respBody, location, err := r.client.DoCreateRequest(ctx, "{{createMethod}}", {{#createHasPathParams}}fmt.Sprintf("{{createPath}}"{{#createArgs}}, {{expr}}{{/createArgs}}){{/createHasPathParams}}{{^createHasPathParams}}"{{createPath}}"{{/createHasPathParams}}, reqBody)
	if err != nil {
		resp.Diagnostics.AddError("Error creating {{resourceName}}", err.Error())
		return
	}

{{#hasRead}}
	// A create may answer a 201 whose body is an identifier and a link, not
	// the resource -- and sometimes only a Location header. Either way what
	// was created has to be READ BACK, not taken from the create's own
	// answer: taking it wrote empty strings over the values just sent,
	// "provider produced inconsistent result after apply".
{{#hasIdAttribute}}
	if created := client.IDFromCreate(respBody, location); created != "" {
		plan.{{idFieldExported}} = types.StringValue(created)
	}
{{/hasIdAttribute}}
{{^hasIdAttribute}}
	// Nothing in this resource's schema holds an identifier, so the Location
	// header has nowhere to go.
	_ = location
{{/hasIdAttribute}}

{{#readHasPathParams}}
	respBody, err = r.client.DoRequest(ctx, "{{readMethod}}", fmt.Sprintf("{{readPath}}"{{^readArgsPlan}}, plan.{{idFieldExported}}{{idFieldValueAccessor}}{{/readArgsPlan}}{{#readArgsPlan}}, {{expr}}{{/readArgsPlan}}), nil)
{{/readHasPathParams}}
{{^readHasPathParams}}
	respBody, err = r.client.DoRequest(ctx, "{{readMethod}}", "{{readPath}}", nil)
{{/readHasPathParams}}
	if err != nil {
		resp.Diagnostics.AddError("Error reading back the created {{resourceName}}", err.Error())
		return
	}
{{/hasRead}}
{{^hasRead}}
	// Nothing to read back with: the create's own answer is all there is.
{{#hasIdAttribute}}
	if len(respBody) == 0 {
		plan.{{idFieldExported}} = types.StringValue(client.IDFromLocation(location))
	}
{{/hasIdAttribute}}
{{^hasIdAttribute}}
	_ = location
{{/hasIdAttribute}}
{{/hasRead}}

{{^responseModel}}
	_ = respBody
{{/responseModel}}
{{#responseModel}}
	if len(respBody) > 0 {
		var result client.{{responseModel}}
		if err := json.Unmarshal(respBody, &result); err != nil {
			resp.Diagnostics.AddError("Error parsing response", err.Error())
			return
		}

		plan.FromClientModel(&result)
	}
{{/responseModel}}

	tflog.Trace(ctx, "created {{resourceName}} resource")
	resp.Diagnostics.Append(resp.State.Set(ctx, &plan)...)
}
