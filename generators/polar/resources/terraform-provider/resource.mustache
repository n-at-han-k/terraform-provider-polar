{{/hasSeparateUpdateModel}}
{{^hasSeparateUpdateModel}}
{{#requestModel}}
	reqBody, err := plan.ToClientModel()
	if err != nil {
		resp.Diagnostics.AddError("Invalid {{resourceName}} configuration", err.Error())
		return
	}
{{/requestModel}}
{{^requestModel}}
	// This operation takes no request body.
	var reqBody interface{}
{{/requestModel}}
{{/hasSeparateUpdateModel}}

{{#updateHasPathParams}}
	respBody, err := r.client.DoRequest(ctx, "{{updateMethod}}", fmt.Sprintf("{{updatePath}}"{{^updateArgs}}, plan.{{idFieldExported}}{{idFieldValueAccessor}}{{/updateArgs}}{{#updateArgs}}, {{expr}}{{/updateArgs}}), reqBody)
{{/updateHasPathParams}}
{{^updateHasPathParams}}
	respBody, err := r.client.DoRequest(ctx, "{{updateMethod}}", "{{updatePath}}", reqBody)
{{/updateHasPathParams}}
	if err != nil {
		resp.Diagnostics.AddError("Error updating {{resourceName}}", err.Error())
		return
	}

{{^responseModel}}
	_ = respBody
{{/responseModel}}
{{#responseModel}}
{{#hasRead}}
	// AN UPDATE'S ANSWER IS NOT THE READ'S. RT answers a PUT with the list of
	// changes it made -- ["Description changed from 'a' to 'b'"] -- and some
	// updates answer nothing at all; neither is the resource, and
