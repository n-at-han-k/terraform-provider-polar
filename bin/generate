#!/usr/bin/env bash
# The whole build: Polar's published document in, one deployable provider out.
#
# What lands in the repo is COMMITTED -- the Dockerfile compiles what is here,
# not what a regeneration would produce. Run this, look at the diff, commit it.
set -euo pipefail

cd "$(dirname "$0")/.."

# THE VENDORED DOCUMENT, UNTOUCHED. The generator reads it and applies the
# configuration bin/generate-config computed from it -- which collections are
# resources, how each union maps onto attributes, which positions cannot be a
# typed block. Nothing rewrites the description on disk any more;
# generators/polar/config.schema.json is the contract between the two sides, and
# reference/resources.md is the thing to read when Polar publishes a new one.
SPEC=reference/polar-openapi.json
CONFIG=reference/generator-config.json

bin/generate-config

test -f "$SPEC" || { echo "missing $SPEC -- run bin/vendor-spec"; exit 1; }
test -f "$CONFIG" || { echo "missing $CONFIG -- bin/generate-config did not write it"; exit 1; }

# Everything under internal/ is generated, and a rename leaves the old file
# behind -- a stale resource compiles just as well as the new one.
rm -rf internal/provider internal/client

# -c, not --additional-properties: the configuration is DERIVED too, and the
# list of positions that cannot be a typed block is longer than a command line
# should carry. reference/generator-config.json is written by bin/generate-config
# from the document, so the generator's settings cannot drift from what the
# document says.
openapi-generator-polar generate \
  -i "$SPEC" \
  -g polar-terraform \
  -o . \
  --git-host github.com \
  --git-user-id n-at-han-k \
  --git-repo-id terraform-provider-polar \
  --additional-properties="polarConfig=$CONFIG"

# MUSTACHE CANNOT COUNT INDENTATION and this template nests attributes inside
# blocks inside blocks, so what comes out is correct Go and unreadable Go. What
# is committed should be the readable half.
gofmt -w internal main.go

# The generator cannot write a go.sum -- only the toolchain knows the hashes,
# and the Dockerfile builds with no network for the module cache.
CGO_ENABLED=0 go mod tidy

CGO_ENABLED=0 go build ./...
echo "built clean"
