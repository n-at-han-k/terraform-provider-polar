#!/usr/bin/env ruby
# frozen_string_literal: true
#
# THE GENERATOR'S CONFIGURATION, computed from the vendored OpenAPI description.
#
# IT COMPUTES AND IT DOES NOT MUTATE. The document the generator reads is the
# vendored one, untouched; this writes the values the generator is TOLD, because
# there are answers it cannot work out accurately from the document alone and a
# generator that guesses them produces a provider that compiles and is wrong.
#
# What belongs here is only that: the union mappings above all, where HCL's "one
# attribute is one type" has to be reconciled with a oneOf. Anything the
# generator can work out for itself stays on its side of the line.
#
# generators/polar/config.schema.json IS THE CONTRACT, and this validates against
# it before writing -- so the two sides cannot drift apart without failing here
# rather than at `tofu plan`.
#
#   bin/vendor-spec      # refresh the vendored description (the only network step)
#   bin/generate-config  # compute the configuration from it
#   bin/generate         # both of those, then generate and build
#
# Do not edit what it writes; edit the rules below and run it again.
require "json"
require "set"

ROOT = File.expand_path("..", __dir__)
SOURCE = File.join(ROOT, "reference", "polar-openapi.json")
PROVENANCE = File.join(ROOT, "reference", "SOURCE")
SCHEMA = File.join(ROOT, "generators", "polar", "config.schema.json")
CONFIG = File.join(ROOT, "reference", "generator-config.json")
MANIFEST = File.join(ROOT, "reference", "resources.md")

PROVIDER_NAME = "polar"
PROVIDER_ADDRESS = "ghcr.io/n-at-han-k/polar"
PROVIDER_VERSION = "1.2.0"

# The leading segment that is the API version rather than part of a resource's
# name. It belongs in the base URL the client already carries.
VERSION_PREFIX = "/v1"

# Creatable and readable, so every structural rule keeps them -- and they
# authenticate with a customer session token rather than the organization token
# this provider holds. Only a human knows that, which is why it is config.
EXCLUDE_PREFIXES = ["#{VERSION_PREFIX}/customer-portal"].freeze

# How deep a typed block goes. Three reaches the deepest the hand-written
# provider has: a meter's filter.clauses[].property, and a license key benefit's
# license_keys_properties.expires.ttl.
NESTED_MAX_DEPTH = 3

# WHICH UNIONS MERGE THEIR CONFLICTING PROPERTIES INSTEAD OF RENAMING THEM.
#
# The hand-written provider does both, so neither can be read off the document. A
# benefit gets one block per kind -- custom_properties, meter_credit_properties
# and six more -- because the kinds have nothing in common. A custom field gets a
# single `properties` block carrying the fields of all five kinds, because they
# very nearly do. Named here because it is a judgement, which is exactly what this
# file is for.
MERGE_CONFLICTS = %w[CustomFieldCreate CustomFieldUpdate].freeze

SCALAR_TYPES = %w[string integer number boolean].freeze
HTTP_METHODS = %w[get post put patch delete].freeze

# -- what the provider block is -----------------------------------------------

# WHICH SECURITY SCHEME THIS PROVIDER AUTHENTICATES WITH, and what a
# configuration calls the credential.
#
# The document declares five of them and no response code says which one a
# Terraform provider should hold: `pat` is a personal token, `customer_session`
# and `member_session` are minted for one end user, and `oidc` is a browser. The
# one that scopes to an organization is `oat`, which is the same reason the
# customer portal's paths are excluded above. Which of them this provider holds,
# and what the block calls it, is therefore a decision.
TOKEN_SCHEME = "oat"
TOKEN_ATTRIBUTE = "access_token"
TOKEN_ENV = "POLAR_ACCESS_TOKEN"
TOKEN_DESCRIPTION = "Polar organization access token. Can also be set with the " \
                    "`#{TOKEN_ENV}` environment variable."

# What a configuration calls the environment, and the variable it falls back to.
# The environments THEMSELVES are the document's -- `servers` names each one and
# says where it lives -- so only the attribute name and the variable are ours.
ENVIRONMENT_ATTRIBUTE = "server"
ENVIRONMENT_ENV = "POLAR_SERVER"
ENVIRONMENT_DESCRIPTION = "The Polar environment to use. Can also be set with " \
                          "the `#{ENVIRONMENT_ENV}` environment variable."

# -- attributes the generator cannot decide -----------------------------------

# WHAT THE SERVER OWNS AND NO CONFIGURATION MAY SET. The document marks nothing
# readOnly, so every response-only field would otherwise reach the schema, and an
# attribute nobody can write is noise in `tofu plan`.
#
#   created_at, modified_at  bookkeeping. They are what the read-after-write
#                             poll compares against, which is a client concern
#                             and not a state's.
#   organization_id          which organization the thing belongs to. The
#                             provider block already IS the organization: one
#                             access token scopes to one, so the attribute could
#                             only ever contradict the credential in use.
DROP_EVERYWHERE = %w[created_at modified_at organization_id].freeze

# OPTIONAL AND COMPUTED, EVERYWHERE IT APPEARS.
#
# An attribute is Optional and Computed when the server fills in a value the
# configuration left out: `metadata` is stored and answered back even when a
# configuration sends none, and Optional alone plans null and then the read
# answers a value, which is "Provider produced inconsistent result after apply"
# on every apply.
#
# Anything ELSE the create body takes without insisting is Optional alone. That
# is the hand-written provider's rule and this generator's used to be the
# opposite, which made half of every resource Optional-and-Computed for no reason
# a configuration could observe.
COMPUTED_EVERYWHERE = %w[metadata price_currency].freeze

# NOTHING IN POLAR'S DESCRIPTION IS SECRET BY ITSELF, and the words in a name
# are not evidence: `guild_token` is a Discord bot token and nothing else in the
# document says so. Listed here because only a person knows.
SENSITIVE_EVERYWHERE = %w[].freeze

# WHAT EACH RESOURCE DOES WITH EACH ATTRIBUTE, keyed by the Terraform resource
# name. This is the hand-written provider's schema, resource by resource, and it
# is the longest part of this file because it is the most judgement there is:
# nothing in the document says that a meter's `unit` is not worth exposing, or
# that an organization's `slug` is the server's to derive.
#
# Each key says one thing, and every one of them is a name a configuration
# spells:
#
#   drop        never exposed, at this level or inside a block
#   include     positions the CREATE body does not take but the resource still
#               offers -- taken from the update body where there is one and from
#               the read answer where there is not
#   required    Required, even where the document says otherwise
#   optional    Optional, even where the document requires it
#   computed    Computed alone, even where a configuration may write it
#   optionalComputed  Optional AND Computed, which is the one combination the
#               document never asks for and a server default does
#   sensitive   Sensitive, whatever its name says
#   set         a Set rather than a List, so a reordered answer is not a diff
#   rename      the name a configuration spells
#   unwrap      a wrapper object that exists only to carry a server default,
#               named by the one property inside it worth having
#   validators  constraints the document does not carry, keyed by attribute
PER_RESOURCE = {
  "polar_benefit" => {
    # The document says `description` is a string. Polar's own application
    # limits it to 42 characters and answers 422 past that, so the schema is
    # where a person finds out first.
    "validators" => { "description" => { "lengthAtMost" => 42 } },
    # Nothing in the description says a Discord bot token is a secret.
    "sensitive" => %w[guild_token],
  },

  "polar_product" => {
    # Polar cannot archive or unarchive through the create body, and a product
    # with no DELETE at all is archived through this -- so the update body's one
    # field has to be reachable.
    "include" => %w[is_archived],
    "optionalComputed" => %w[medias is_archived],
    # `seat_tiers` is a wrapper object whose only required field is `tiers`, and
    # whose other field defaults to `volume`. As the wrapper it is a block
    # holding a block; as the list it is what a configuration actually means.
    "unwrap" => { "seat_tiers" => "tiers" },
    # The document requires the tiers list because its own form does; the tier
    # whose maximum is left out is how an unlimited one is spelled.
    "optional" => %w[seat_tiers],
  },

  "polar_meter" => {
  },

  "polar_discount" => {
    # A fixed discount with no amounts and a percentage one with no basis points
    # are both refused by Polar's application, and neither is in the document's
    # required list -- that list is the union of every variant's, and only `name`
    # and `duration` are in all of them.
    # `duration_in_months` belongs to a repeating discount and to no other, and
    # every `type` arm carries it -- so the flattening cannot tell, and the
    # OTHER discriminator is the one that decides. A dotted key names the
    # discriminator it belongs to; a bare one means the resource's own.
    "conflictWhen" => {
      "duration.repeating" => %w[duration_in_months],
    },
    # And the other half: a repeating discount has to say for how long.
    "requiredWhen" => {
      "fixed" => %w[amounts],
      "percentage" => %w[basis_points],
      "duration.repeating" => %w[duration_in_months],
    },
  },

  "polar_custom_field" => {
    # Five kinds of custom field merged into one `properties` block, so which
    # kind applies is not known until the discriminator is read -- and a schema
    # cannot wait for that. Required in every variant is not the same as
    # required by the configuration.
    "optional" => %w[properties],
    # WHICH FIELD BELONGS TO WHICH KIND, which the merge makes invisible: all five
    # kinds share one block, so nothing in the schema says that `textarea` is a
    # text field's and `options` a select one's.
    "conflictWhen" => {
      "text" => %w[textarea],
      "number" => %w[ge le],
      "select" => %w[options],
    },
  },

  "polar_organization" => {
    # Polar creates the organization itself from the access token and derives
    # the slug; the document marks both required because its own form does, not
    # because the API insists.
    "optional" => %w[name socials feature_settings customer_email_settings
                       subscription_settings],
    # Every one of these toggles is filled in by Polar when a configuration
    # leaves it out, and the document requires all of them because its own form
    # submits all of them. Optional AND Computed says both: a configuration may
    # name one, and the server will fill in the other thirteen.
    "optionalComputed" => %w[
                       order_confirmation subscription_cancellation
                       subscription_confirmation subscription_cycled
                       subscription_cycled_after_trial subscription_past_due
                       subscription_revoked subscription_uncanceled
                       subscription_updated
                       allow_customer_updates allow_multiple_subscriptions
                       benefit_revocation_grace_period prevent_trial_abuse
                       proration_behavior
                       issue_funding_enabled revops_enabled wallets_enabled
                       member_model_enabled seat_based_pricing_enabled],
    "computed" => %w[slug],
    # A block whose children describe what the SERVER ANSWERS rather than what
    # the request carries. Polar's own document has two schemas for these
    # settings -- an Update to send and a Settings to read back -- and they are
    # not the same fields; typed from the request, `feature_settings` would
    # offer `checkout_localization_enabled` and hide `wallets_enabled`.
    "responseBlocks" => %w[feature_settings],
  },

  "polar_checkout_link" => {
    # The create body is a union of "one product", "one product price" and
    # "these products". A configuration says which by spelling `product_ids`,
    # and the answer carries the URL to send the customer to and the secret the
    # public checkout is addressed by.
    "include" => %w[products url client_secret],
    "rename" => { "products" => "product_ids" },
    "set" => %w[product_ids],
    "sensitive" => %w[client_secret],
    "computed" => %w[url client_secret payment_processor],
    "optionalComputed" => %w[allow_discount_codes require_billing_address],
  },

  "polar_webhook_endpoint" => {

    # `enabled` is only ever changed through the update body, and the secret
    # only ever read -- there is no endpoint that hands one out at create, so it
    # is computed and sensitive, and it is in the read answer.
    "include" => %w[enabled secret],
    "computed" => %w[secret],
    # Polar generates the name when a configuration omits it.
    "optionalComputed" => %w[enabled name],
    "sensitive" => %w[secret],
    # Which ones matter, not what order: a set of event types.
    "set" => %w[events],
    # `format: uri` says nothing Polar will not answer: it will not deliver to
    # an http:// endpoint, and only Polar knows that.
    "validators" => {
      "url" => {
        "pattern" => "^https://",
        "message" => "webhook URL must use HTTPS",
      },
    },
  },
}.freeze

# -- the document, read and never written ------------------------------------

unless File.exist?(SOURCE)
  abort("missing reference/polar-openapi.json -- run bin/vendor-spec to fetch it")
end

SPEC = JSON.parse(File.read(SOURCE)).freeze
SCHEMAS = SPEC.dig("components", "schemas").freeze

warn("#{SPEC.dig('info', 'title')} #{SPEC.dig('info', 'version')}: " \
     "#{SPEC['paths'].size} paths, #{SCHEMAS.size} schemas")
warn(File.read(PROVENANCE).lines.grep(/sha256|fetched/).map(&:strip).join(", ")) if File.exist?(PROVENANCE)

# -- which collections are resources -----------------------------------------

# A trailing /{param} is the member of a collection, not a collection.
def collection_of(path)
  trimmed = path.length > 1 && path.end_with?("/") ? path[0..-2] : path
  cut = trimmed.rindex("/")

  if cut&.positive? && trimmed.end_with?("}") && trimmed[(cut + 1)..].start_with?("{")
    trimmed[0...cut]
  else
    trimmed
  end
end

def member?(path)
  trimmed = path.length > 1 && path.end_with?("/") ? path[0..-2] : path
  collection_of(path) != trimmed
end

def excluded?(collection)
  EXCLUDE_PREFIXES.any? { |prefix| collection == prefix || collection.start_with?("#{prefix}/") }
end

# A RESOURCE IS ONE TERRAFORM CAN CREATE AND READ BACK.
#
# Without a create it is a report: /metrics, /events and /payments are readable
# and cannot be brought into being, and as a resource tofu offers to create one
# on the first plan and the apply fails.
#
# Without a read on its member it is a verb: /events/ingest, /oauth2/register and
# /orders/{id}/finalize take a POST and answer nothing addressable, so there is
# no state to refresh and no drift to detect.
def collections
  @collections ||= SPEC["paths"].each_with_object({}) do |(path, item), found|
    group = found[collection_of(path)] ||= { create: false, read: false, paths: {} }
    is_member = member?(path)

    item.each do |method, operation|
      next unless HTTP_METHODS.include?(method)

      (group[:paths][path] ||= []) << method.upcase
      group[:read] = true if is_member && method == "get"
      group[:create] = true if !is_member && method == "post" &&
                               (operation["responses"] || {}).key?("201")
    end
  end
end

kept, dropped = collections.partition do |collection, group|
  group[:create] && group[:read] && !excluded?(collection)
end

# The collection path as the document spells it, trailing slash and all, because
# that is what the generator will compare against.
resource_paths = kept.map do |collection, group|
  group[:paths].keys.min_by(&:length)
end.sort

# -- unions ------------------------------------------------------------------

def refs_in(node, found = [])
  case node
  when Hash
    ref = node["$ref"]
    found << ref.split("/").last if ref.is_a?(String) && ref.start_with?("#/components/schemas/")
    node.each_value { |value| refs_in(value, found) }
  when Array
    node.each { |value| refs_in(value, found) }
  end

  found
end

# Every schema a named schema reaches, transitively, including itself when it is
# recursive. Memoised: the recursion check below asks this per variant.
def closure_of(name, cache = ($closures ||= {}))
  return cache[name] if cache.key?(name)

  cache[name] = []
  frontier = refs_in(SCHEMAS[name] || {})
  seen = {}

  until frontier.empty?
    reached = frontier.pop
    next if seen[reached]

    seen[reached] = true
    frontier.concat(refs_in(SCHEMAS[reached] || {}))
  end

  cache[name] = seen.keys
end

def union_members(node)
  members = node["oneOf"] || node["anyOf"]
  members.is_a?(Array) && members.size > 1 ? members : nil
end

# A union whose branches are all scalars has no shape to flatten -- it needs one
# type that can carry any of them. Numeric kinds widen to a number; differing
# kinds have only a string in common.
#
# A `null` branch is nullability rather than a branch, and a union with ONE
# branch left is that branch -- nothing to decide, and the generator collapses it
# structurally. Several branches of the SAME kind do need saying: a
# subscription's `trial_end` is `anyOf: [date-time, const "now", null]`, two
# spellings of a string, and without an entry it stayed a composition and came
# out `type SubscriptionUpdateTrialEnd struct{}`.
def widening(members)
  typed = members.reject { |m| m.is_a?(Hash) && m["type"] == "null" }
  return nil if typed.size < 2
  return nil unless typed.all? { |m| m.is_a?(Hash) && SCALAR_TYPES.include?(m["type"]) }

  kinds = typed.map { |m| m["type"] }.uniq
  return kinds.first if kinds.size == 1

  (kinds - %w[integer number]).empty? ? "number" : "string"
end

# Variant schema name -> the label its conflicting properties are renamed with.
# The discriminator's own mapping is the authority; without one, the variant's
# schema name is all there is to go on.
def labels_for(node, variants)
  mapping = node.dig("discriminator", "mapping") || {}

  variants.to_h do |name|
    # The discriminator's own value where it has one, else the variant's schema
    # name with the Create/Update suffix off. SNAKE-CASED EITHER WAY: some
    # mappings use the PascalCase schema name as the discriminator value, and a
    # label becomes part of an attribute name, which must be snake_case. The
    # value the API is sent is untouched -- only what a configuration spells.
    key = mapping.find { |_, ref| ref.split("/").last == name }&.first
    source = key || name.sub(/(Create|Update)\z/, "")

    # A discriminator value is whatever the API chose and need not be an
    # identifier at all: Polar's event types are `meter.credited` and
    # `benefit.granted`. Every character a Terraform attribute name cannot carry
    # becomes an underscore.
    [name, source.gsub(/([a-z0-9])([A-Z])/, '\1_\2')
                 .downcase
                 .gsub(/[^a-z0-9]+/, "_")
                 .gsub(/\A_+|_+\z/, "")]
  end
end

# One entry per union position, keyed by where it sits: the schema name for a
# named union, `<Schema>.<property>` for one declared inline,
# `<Schema>.<property>.items` for one inside an array and
# `<Schema>.<property>.values` for one behind `additionalProperties`.
#
# DESCENDS ONLY THROUGH `properties` AND `items`. A generic walk over every value
# re-entered the `properties` map under the same key and never terminated; and a
# union's own members do not need walking, because each one is a named schema
# visited in its own right.
def union_entries
  entries = {}

  walk = lambda do |node, key|
    if node.is_a?(Array)
      node.each { |value| walk.call(value, key) }
      return
    end
    return unless node.is_a?(Hash)

    members = union_members(node)

    if members
      widen = widening(members)

      if widen
        entries[key] = { "widen" => widen }
      else
        refs = members.map { |member| member.is_a?(Hash) ? member["$ref"] : nil }

        if refs.all? { |ref| ref.to_s.start_with?("#/components/schemas/") }
          names = refs.map { |ref| ref.split("/").last }
          objects = names.select do |name|
            SCHEMAS[name].is_a?(Hash) && SCHEMAS[name]["type"] == "object" && SCHEMAS[name]["properties"]
          end

          if objects.size == names.size
            # A variant that reaches back into the union cannot be flattened --
            # inlining it puts a schema inside itself. Terraform cannot express
            # arbitrary nesting anyway, so the recursive branch is dropped and the
            # leaf survives.
            recursive = names.select { |name| (closure_of(name) & names).any? }
            remaining = names - recursive

            unless remaining.empty?
              entry = { "variants" => labels_for(node, remaining) }
              discriminator = node.dig("discriminator", "propertyName")
              entry["discriminator"] = discriminator if discriminator
              entry["drop"] = recursive unless recursive.empty?
              entry["conflicts"] = "merge" if MERGE_CONFLICTS.include?(key)
              entries[key] = entry
            end
          end
        end
      end
    end

    (node["properties"] || {}).each do |property, schema|
      walk.call(schema, "#{key}.#{property}")
    end
    walk.call(node["items"], "#{key}.items") if node["items"]

    # AND THROUGH A LONE SURVIVING BRANCH, under the same key, because that is
    # what the position becomes: `CheckoutUpdate.customer_metadata` is
    # `anyOf: [<a map>, null]`, so the map -- and the union inside it -- sits one
    # level further down than the key the generator will look for.
    if members && members.reject { |m| m.is_a?(Hash) && m["type"] == "null" }.size == 1
      walk.call(members.reject { |m| m.is_a?(Hash) && m["type"] == "null" }.first, key)
    end

    # AND INTO A MAP'S VALUE TYPE. `metadata` is `additionalProperties: anyOf
    # [string, integer, number, boolean]` -- a union in the one position the walk
    # did not look, so nothing was said about it and openapi-generator lifted it
    # into a model with no properties.
    walk.call(node["additionalProperties"], "#{key}.values") if node["additionalProperties"].is_a?(Hash)
  end

  SCHEMAS.each { |name, schema| walk.call(schema, name) }
  entries
end

# -- named schemas that are not objects --------------------------------------

# A NAMED SCHEMA WITH A SCALAR TYPE IS THAT SCALAR, however many enum values it
# carries. openapi-generator gives each one a model and the templates render a
# model as a struct, so without this the generator has to work out that
# `WebhookEventType` is a string -- and where it cannot, it falls back to
# `interface{}` and the attribute becomes a string holding JSON.
#
# Computed from the document rather than guessed at: `type` is right there.
def scalar_schemas
  SCHEMAS.each_with_object({}) do |(name, schema), found|
    next unless schema.is_a?(Hash)
    next unless SCALAR_TYPES.include?(schema["type"])

    found[name] = schema["type"]
  end
end

# -- named schemas that are only another name --------------------------------

# A SCHEMA WHOSE WHOLE BODY IS A `$ref` IS THE THING IT POINTS AT.
# `CheckoutCreate` is one of these, and openapi-generator mints a model for it
# carrying none of the target's properties -- an empty struct where the checkout
# resource's create body should be.
def alias_schemas
  SCHEMAS.each_with_object({}) do |(name, schema), found|
    next unless schema.is_a?(Hash) && schema.keys == ["$ref"]

    found[name] = schema["$ref"].split("/").last
  end
end

# -- freeform positions ------------------------------------------------------

# A freeform map has no declared properties, so no attribute could be checked
# against it. Matched by property NAME, deliberately: `metadata` is the same
# freeform map wherever it appears.
def json_properties
  names = []

  walk = lambda do |node|
    case node
    when Hash
      (node["properties"] || {}).each do |property, schema|
        next unless schema.is_a?(Hash)

        subject = schema["type"] == "array" ? (schema["items"] || {}) : schema
        next unless subject.is_a?(Hash)

        # A MAP IS NOT FREEFORM. `metadata` is `additionalProperties: {string}`,
        # which is a map of strings and a typed attribute; only an object with
        # neither declared properties NOR an additionalProperties schema has
        # nothing a configuration could be checked against.
        freeform = subject["type"] == "object" && !subject.key?("$ref") &&
                   (subject["properties"].nil? || subject["properties"].empty?) &&
                   !subject["additionalProperties"].is_a?(Hash)

        names << property if freeform
      end

      node.each_value { |value| walk.call(value) }
    when Array
      node.each { |value| walk.call(value) }
    end
  end

  walk.call(SPEC)
  names.uniq.sort
end

# -- the environments the document declares -----------------------------------

# WHERE THIS PROVIDER CAN POINT, from the document's own `servers`.
#
# Every one of them carries an id, which is what a configuration spells --
# `production`, `sandbox` -- rather than the URL, which is the server's answer to
# being told. The version prefix is lifted on, because that is where the
# generator puts it too: the whole API is at `/v1`, not one route of it.
def environments
  Array(SPEC["servers"]).each_with_object([]) do |server, found|
    name = server.is_a?(Hash) ? server["x-speakeasy-server-id"] : nil
    url = server.is_a?(Hash) ? server["url"] : nil
    next unless name.is_a?(String) && url.is_a?(String)

    found << { "name" => name, "url" => url.sub(%r{/\z}, "") + VERSION_PREFIX }
  end
end

# -- the resource a collection is called ---------------------------------------

# The Terraform name, from the collection path: every literal segment,
# dash-to-underscore, plural stripped. The generator works this out the same way
# (TerraformCodegen.toApiName) and the two have to agree, because the
# per-resource answers above are keyed by the name a configuration spells.
def terraform_name(collection)
  segments = collection.delete_prefix(VERSION_PREFIX).split("/").reject { |s| s.empty? || s.start_with?("{") }
  segments = segments.map { |s| s.tr("-", "_").sub(/s\z/, "") }
  segments = segments.map { |s| s.sub(/_ss\z|_us\z|_sts\z/, "") }

  "#{PROVIDER_NAME}_#{segments.join('_')}"
end

# -- validate against the contract, then write -------------------------------

config = {
  "version" => 1,
  "provider" => {
    "name" => PROVIDER_NAME,
    "address" => PROVIDER_ADDRESS,
    "version" => PROVIDER_VERSION,
    "token" => {
      "attribute" => TOKEN_ATTRIBUTE,
      "scheme" => TOKEN_SCHEME,
      "env" => TOKEN_ENV,
      "description" => TOKEN_DESCRIPTION,
    },
    "environment" => {
      "attribute" => ENVIRONMENT_ATTRIBUTE,
      "env" => ENVIRONMENT_ENV,
      "description" => ENVIRONMENT_DESCRIPTION,
      "values" => environments,
    },
  },
  "document" => {
    "versionPrefix" => VERSION_PREFIX,
    "excludePrefixes" => EXCLUDE_PREFIXES,
  },
  "resources" => { "include" => resource_paths },
  "attributes" => {
    "nestedMaxDepth" => NESTED_MAX_DEPTH,
    "json" => json_properties,
    "drop" => DROP_EVERYWHERE,
    "computed" => COMPUTED_EVERYWHERE,
    "sensitive" => SENSITIVE_EVERYWHERE,
    "byResource" => PER_RESOURCE,
  },
  "unions" => union_entries,
  "scalars" => scalar_schemas,
  "aliases" => alias_schemas,
}

# A hand-rolled check of the few things the schema insists on, because a JSON
# Schema validator is a gem this repo does not otherwise need. It is the same
# contract either way: a key the generator will not understand must fail here.
schema = JSON.parse(File.read(SCHEMA))
required = schema["required"]
missing = required - config.keys
abort("config is missing #{missing.join(', ')}") unless missing.empty?

config["unions"].each do |key, entry|
  unless entry.key?("variants") || entry.key?("widen")
    abort("union #{key} has neither variants nor widen")
  end
  (entry["variants"] || {}).each_value do |label|
    abort("union #{key}: label #{label.inspect} is not snake_case") unless label.match?(/\A[a-z][a-z0-9_]*\z/)
  end
end

# The per-resource answers are keyed by the name a configuration spells, and a
# typo in one is an attribute the generator will never look for -- so a key that
# names no resource this provider generates fails here rather than silently
# doing nothing.
known = kept.map { |collection, _| terraform_name(collection) }.to_set
PER_RESOURCE.each_key do |resource|
  abort("byResource has #{resource.inspect}, which is not a resource: #{known.to_a.sort.join(', ')}") unless known.include?(resource)
end

# The document's own environments, or there is nothing for the `server` attribute
# to be one of.
abort("the document declares no named server to choose between") if environments.empty?

File.write(CONFIG, "#{JSON.pretty_generate(config)}\n")

File.open(MANIFEST, "w") do |io|
  io.puts "<!-- GENERATED by bin/generate-config. Do not edit. -->"
  io.puts
  io.puts "# Polar #{SPEC.dig('info', 'version')} -> provider resources"
  io.puts
  io.puts "A collection is a resource when it has a **create** (`POST` answering 201) and a"
  io.puts "**read** on its member (`GET /thing/{id}`). Without a create it is a report;"
  io.puts "without a member read it is a verb. The customer portal is excluded by name: its"
  io.puts "paths are creatable and readable, and authenticate with a customer session rather"
  io.puts "than this provider's organization token."
  io.puts
  io.puts "#{kept.size} resources from #{collections.size} collections."
  io.puts
  io.puts "| resource | collection | operations | note |"
  io.puts "|---|---|---|---|"

  kept.sort_by(&:first).each do |collection, group|
    name = terraform_name(collection)
    verbs = group[:paths].values.flatten.uniq.sort
    note = verbs.include?("DELETE") ? "" : "**no DELETE** -- cannot be destroyed or replaced"

    io.puts "| `#{name}` | `#{collection}` | #{verbs.join(', ')} | #{note} |"
  end

  io.puts
  io.puts "## Dropped (#{dropped.size})"
  io.puts
  io.puts "| collection | why |"
  io.puts "|---|---|"

  dropped.sort_by(&:first).each do |collection, group|
    why = if excluded?(collection)
            "customer-session auth, not an organization token"
          else
            [group[:create] ? nil : "no create (a report)",
             group[:read] ? nil : "no member read (a verb)"].compact.join(", ")
          end

    io.puts "| `#{collection}` | #{why} |"
  end

  io.puts
  io.puts "## Per-resource attributes"
  io.puts
  io.puts "The document marks nothing readOnly, so every response-only field would reach"
  io.puts "the schema, and every optional field the server fills in would be Optional AND"
  io.puts "Computed. Both are decisions rather than consequences, and they are recorded in"
  io.puts "this table -- which is what `attributes.drop` and `attributes.byResource` in the"
  io.puts "generator configuration say."
  io.puts
  io.puts "| resource | dropped everywhere | not exposed | only the update/read body has it | optional AND computed | sensitive |"
  io.puts "|---|---|---|---|---|---|"

  kept.sort_by(&:first).each do |collection, _|
    name = terraform_name(collection)
    per = PER_RESOURCE[name] || {}

    say = lambda do |key|
      values = Array(per[key])
      values.empty? ? "" : "`#{values.join('`, `')}`"
    end

    io.puts "| `#{name}` | `#{DROP_EVERYWHERE.join('`, `')}` | #{say.call('drop')} | " \
             "#{say.call('include')} | #{say.call('optionalComputed')} | #{say.call('sensitive')} |"
  end
end

widened = config["unions"].count { |_, e| e.key?("widen") }
warn("resources: #{kept.size} kept, #{dropped.size} dropped")
warn("unions: #{config['unions'].size} (#{widened} widened to a scalar, " \
     "#{config['unions'].size - widened} flattened)")
warn("json-only properties: #{config['attributes']['json'].size}")
warn("environments: #{config['provider']['environment']['values'].map { |e| e['name'] }.join(', ')}")
warn("per-resource attribute decisions: #{PER_RESOURCE.size}")
warn("named scalar schemas: #{config['scalars'].size}, aliases: #{config['aliases'].size}")
warn("wrote #{CONFIG.sub("#{ROOT}/", '')} and #{MANIFEST.sub("#{ROOT}/", '')}")
