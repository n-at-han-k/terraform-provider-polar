{
  "version": 1,
  "provider": {
    "name": "polar",
    "address": "ghcr.io/n-at-han-k/polar",
    "version": "1.3.0",
    "token": {
      "attribute": "access_token",
      "scheme": "oat",
      "env": "POLAR_ACCESS_TOKEN",
      "description": "Polar organization access token. Can also be set with the `POLAR_ACCESS_TOKEN` environment variable."
    },
    "environment": {
      "attribute": "server",
      "env": "POLAR_SERVER",
      "description": "The Polar environment to use. Can also be set with the `POLAR_SERVER` environment variable.",
      "values": [
        {
          "name": "production",
          "url": "https://api.polar.sh/v1"
        },
        {
          "name": "sandbox",
          "url": "https://sandbox-api.polar.sh/v1"
        }
      ]
    }
  },
  "document": {
    "versionPrefix": "/v1",
    "excludePrefixes": [
      "/v1/customer-portal"
    ]
  },
  "resources": {
    "include": [
      "/v1/benefits/",
      "/v1/checkout-links/",
      "/v1/checkouts/",
      "/v1/custom-fields/",
      "/v1/customers/",
      "/v1/customers/external/{external_id}/members",
      "/v1/customers/{id}/members",
      "/v1/discounts/",
      "/v1/meters/",
      "/v1/metrics/dashboards",
      "/v1/orders/",
      "/v1/organizations/",
      "/v1/products/",
      "/v1/subscriptions/",
      "/v1/webhooks/endpoints"
    ]
  },
  "attributes": {
    "nestedMaxDepth": 3,
    "json": [
      "authorization_parameters",
      "client_context",
      "ctx",
      "detail",
      "processor_metadata"
    ],
    "drop": [
      "created_at",
      "modified_at",
      "organization_id"
    ],
    "computed": [
      "metadata",
      "price_currency"
    ],
    "sensitive": [],
    "byResource": {
      "polar_benefit": {
        "validators": {
          "description": {
            "lengthAtMost": 42
          }
        },
        "sensitive": [
          "guild_token"
        ]
      },
      "polar_product": {
        "include": [
          "is_archived"
        ],
        "optionalComputed": [
          "medias",
          "is_archived"
        ],
        "unwrap": {
          "seat_tiers": "tiers"
        },
        "optional": [
          "seat_tiers"
        ]
      },
      "polar_meter": {},
      "polar_discount": {
        "conflictWhen": {
          "duration.repeating": [
            "duration_in_months"
          ]
        },
        "requiredWhen": {
          "fixed": [
            "amounts"
          ],
          "percentage": [
            "basis_points"
          ],
          "duration.repeating": [
            "duration_in_months"
          ]
        }
      },
      "polar_custom_field": {
        "optional": [
          "properties"
        ],
        "conflictWhen": {
          "text": [
            "textarea"
          ],
          "number": [
            "ge",
            "le"
          ],
          "select": [
            "options"
          ]
        }
      },
      "polar_organization": {
        "optional": [
          "name",
          "socials",
          "feature_settings",
          "customer_email_settings",
          "subscription_settings"
        ],
        "optionalComputed": [
          "order_confirmation",
          "subscription_cancellation",
          "subscription_confirmation",
          "subscription_cycled",
          "subscription_cycled_after_trial",
          "subscription_past_due",
          "subscription_revoked",
          "subscription_uncanceled",
          "subscription_updated",
          "allow_customer_updates",
          "allow_multiple_subscriptions",
          "benefit_revocation_grace_period",
          "prevent_trial_abuse",
          "proration_behavior",
          "issue_funding_enabled",
          "revops_enabled",
          "wallets_enabled",
          "member_model_enabled",
          "seat_based_pricing_enabled"
        ],
        "computed": [
          "slug"
        ],
        "responseBlocks": [
          "feature_settings"
        ]
      },
      "polar_checkout_link": {
        "include": [
          "products",
          "url",
          "client_secret"
        ],
        "rename": {
          "products": "product_ids"
        },
        "set": [
          "product_ids"
        ],
        "sensitive": [
          "client_secret"
        ],
        "computed": [
          "url",
          "client_secret",
          "payment_processor"
        ],
        "optionalComputed": [
          "allow_discount_codes",
          "require_billing_address"
        ]
      },
      "polar_webhook_endpoint": {
        "include": [
          "enabled",
          "secret"
        ],
        "computed": [
          "secret"
        ],
        "optionalComputed": [
          "enabled",
          "name"
        ],
        "sensitive": [
          "secret"
        ],
        "set": [
          "events"
        ],
        "validators": {
          "url": {
            "pattern": "^https://",
            "message": "webhook URL must use HTTPS"
          }
        }
      }
    }
  },
